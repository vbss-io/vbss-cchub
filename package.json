{
  "name": "vbss-cchub",
  "version": "1.4.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm run dev -w @cch/server\" \"npm run dev -w @cch/ui\"",
    "build": "npm run build -w @cch/server && npm run build -w @cch/ui",
    "build:app": "npm run build -w @cch/ui && node apps/desktop/build-sidecar.mjs",
    "build:sidecar": "node apps/desktop/build-sidecar.mjs",
    "typecheck": "npm run typecheck -w @cch/server && npm run typecheck -w @cch/ui",
    "desktop:dev": "npm run dev -w @cch/desktop",
    "desktop:build": "npm run build -w @cch/desktop",
    "release": "node scripts/release.mjs",
    "test": "npm test -w @cch/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "overrides": {
    "@asamuzakjp/css-color": "7.1.7",
    "@asamuzakjp/dom-selector": "10.0.4",
    "@babel/helper-string-parser": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/runtime": "7.29.10",
    "@babel/types": "7.29.8",
    "@csstools/css-color-parser": "4.2.6",
    "@csstools/css-syntax-patches-for-csstree": "1.1.15",
    "@types/estree": "1.0.9",
    "magic-string": "1.4.3",
    "parse5": "8.0.1",
    "tinybench": "6.2.2",
    "tldts-core": "7.4.19"
  }
}
